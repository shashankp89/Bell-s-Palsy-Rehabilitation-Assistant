# Firebase configuration for real Google + email/password auth
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Access control settings
VITE_ALLOWED_EMAIL_DOMAINS=gmail.com,googlemail.com
VITE_ADMIN_EMAIL=admin@gmail.com
# Used only for local demo mode. Create this account in Firebase for production.
VITE_ADMIN_PASSWORD=Admin@123

# Optional: set to true only for local demo mode without Firebase
VITE_USE_DEMO_MODE=false
